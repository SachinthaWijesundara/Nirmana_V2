def:pub Icon(name: str, size: int = 20, color: str = "currentColor") -> JsxElement {
    paths: list[str] = ICONS[name] if name in ICONS else [];
    return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{"flexShrink": 0}}>
        {for (i, d) in enumerate(paths) {
            <path key={str(i)} d={d} />
        }}
    </svg>;
}
